# Optional: your LLM key, kept on the server (it never reaches the browser).
# Without one, paste a key in the app instead (click "Add API key").
# Set one of these; the first provider with a key is used.
GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional
# LLM_PROVIDER=google               # pick the provider when several keys are set
# LLM_MODEL=gemini-3.6-flash        # default per provider; can also be picked in the app
# SERVER_KEY_ANSWERS_PER_HOUR=30    # limit answers per visitor on this key (off by default)
# ALLOW_FAULTS=true                 # failure injection for the browser tests (on by default in development)
