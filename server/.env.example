# Optional: the server's own key. Without it, paste a key in the app ("Model & key").
# Pick a provider and set its key (or LLM_API_KEY, which works for any provider).
LLM_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional
# LLM_MODEL=gemini-3.6-flash        # default per provider
# DEMO_ANSWERS_PER_HOUR=30          # per visitor, when the server key answers
# ALLOW_FAULTS=true                 # failure injection for the browser tests (on by default in development)
